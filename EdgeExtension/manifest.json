{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "__MSG_short__",
  "version": "1.6.0",
  "default_locale": "zh_CN",
  "key": "",
  "description": "__MSG_desc__",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:48613/*",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://music.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "youtube.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "debugger"
  ]
}
